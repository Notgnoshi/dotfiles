#!/bin/bash
set -o errexit
set -o pipefail
set -o nounset
set -o noclobber

# Filter out anything other than normal files (notably submodules)
filter_files() {
    while read -r -d '' path; do
        if [[ -f "$path" ]]; then
            printf '%s\0' "$path"
        fi
    done
}

# Quickly open modified and untracked (non-ignored) files in your $EDITOR
git ls-files -z --modified --others --exclude-standard |
    filter_files |
    xargs --null --open-tty "${EDITOR:-vim}" "$@"
