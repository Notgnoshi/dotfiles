#!/bin/bash
set -o errexit
set -o pipefail
set -o nounset
set -o noclobber

# Filter out anything other than normal files (notably submodules)
filter_files() {
    while read -r -d '' path; do
        if [[ -f "$path" ]]; then
            printf '%s\0' "$path"
        fi
    done
}

staged=false
editor_args=()
for arg in "$@"; do
    if [[ "$arg" == "--staged" ]]; then
        staged=true
    else
        editor_args+=("$arg")
    fi
done

{
    git ls-files -z --modified --others --exclude-standard
    if [[ "$staged" == true ]]; then
        git diff --staged -z --name-only
    fi
} |
    filter_files |
    sort -z -u |
    xargs --null --open-tty "${EDITOR:-vim}" "${editor_args[@]}"
